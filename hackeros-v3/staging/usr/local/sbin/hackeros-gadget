#!/bin/bash

set -euo pipefail

G=/sys/kernel/config/usb_gadget/hackeros
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
[ -d "$G" ] && [ ! -f "$G/UDC" ] && rm -rf "$G"
mkdir -p "$G"
echo 0x1d6b >"$G/idVendor"
echo 0x0104 >"$G/idProduct"
echo 0x0200 >"$G/bcdUSB"
echo 0x0300 >"$G/bcdDevice"
mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409"
serial="$(cat /etc/machine-id | cut -c1-16)"
echo "$serial" >"$G/strings/0x409/serialnumber"
echo "GameHack Zero" >"$G/strings/0x409/manufacturer"
echo "GameHack Zero V3" >"$G/strings/0x409/product"
echo "OTG maintenance network" >"$G/configs/c.1/strings/0x409/configuration"
echo 250 >"$G/configs/c.1/MaxPower"
mkdir -p "$G/functions/ecm.usb0"
hash="$(printf '%s' "$serial" | sha256sum | cut -c1-10)"
echo "02:${hash:0:2}:${hash:2:2}:${hash:4:2}:${hash:6:2}:${hash:8:2}" >"$G/functions/ecm.usb0/host_addr"
echo "06:${hash:0:2}:${hash:2:2}:${hash:4:2}:${hash:6:2}:${hash:8:2}" >"$G/functions/ecm.usb0/dev_addr"
ln -s "$G/functions/ecm.usb0" "$G/configs/c.1/ecm.usb0"

for _ in $(seq 1 30); do
  udc="$(ls /sys/class/udc 2>/dev/null | head -n 1)"
  [ -n "$udc" ] && break
  sleep 1
done
[ -n "${udc:-}" ] || { echo "No USB device controller found."; exit 1; }
echo "$udc" >"$G/UDC"
