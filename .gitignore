# Ignore rules are not a security boundary: review staged files before publishing.
# Already tracked files are NOT protected by adding patterns here.

# OS images and generated release assets belong in GitHub Releases, not Git.
images/
releases/
*.img
*.img.*
*.iso
*.raw
*.qcow2
*.vhd
*.vhdx
*.xz
*.partial
*.part

# Personal backups, card maintenance, and credentialed image-test clones.
access/
backups/
sd2-maintenance/
update-backup/
image-validation-private*/
*.pre-*
*.bak
*.old
*~

# SSH identities, provider authentication, and local secrets.
.ssh/
.gnupg/
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
id_ed25519*
id_rsa*
id_ecdsa*
id_dsa*
ssh_host_*
known_hosts*
authorized_keys*
bootstrap-password
auth.json
credentials.json
secrets.json
secrets.local.*
.netrc
.npmrc
machine-id
random-seed
shadow
shadow-
gshadow
gshadow-

# Network profiles can contain Wi-Fi passwords. Keep only reviewed USB presets.
*.nmconnection
!hackeros-v3/staging/etc/NetworkManager/system-connections/gamehack-pi-worker.nmconnection
!gamehack-companion/staging/etc/NetworkManager/system-connections/gamehack-usb.nmconnection
wpa_supplicant.conf

# Personal device data, packet captures, logs, and saved games.
vault/
captures/
device-logs/
private-logs/
nimbus-docs/
saves/
savegames/
*.pcap
*.pcapng
*.cap
*.journal
*.journal~
*.log
*.lmp
*.dsg

# Game/media payloads: retain source, documentation, and preparation scripts.
roms/
bios/
*.wad
*.ir
*.nes
*.sfc
*.smc
*.gb
*.gbc
*.gba
*.nds
*.3ds
*.n64
*.z64
*.v64
*.chd
*.cso
*.pbp
# Do not blanket-ignore .bin/.zip/.json: these can be legitimate source assets.
hackeros-v3/staging/usr/local/bin/opencode
hackeros-v3/staging/usr/local/share/gamehack-zero/ir-database/
hackeros-v3/release-4.2.0.json

# Downloaded driver builds and compiled output.
driver-build/
*.ko
*.o
*.a
*.so
*.so.*
build/
dist/
*.egg-info/

# Python/JS environments, caches, and test reports.
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editor/desktop temporary files; do not hide shared editor configuration.
*.swp
*.swo
.DS_Store
._*
Thumbs.db
Desktop.ini
